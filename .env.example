# Environment configuration
# Copy this file to .env and fill in your values

# ── Anthropic ──────────────────────────────────────────────────────────────────
# Required for real AI agents. Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Claude model to use (default: claude-sonnet-4-6)
MODEL=claude-sonnet-4-6

# ── PatentsView ────────────────────────────────────────────────────────────────
# Optional. Without a key the API still works at a lower rate limit.
# Apply at https://patentsview.org/apis/purpose
PATENTSVIEW_API_KEY=

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001

# ── Demo mode ──────────────────────────────────────────────────────────────────
# Set to "true" to return realistic sample data without any API keys.
# Great for hackathon demos when you don't want to burn API credits.
MOCK_MODE=true
